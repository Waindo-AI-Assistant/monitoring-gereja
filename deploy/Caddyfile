# Reverse proxy HTTPS untuk aplikasi.
# Caddy otomatis mengambil sertifikat Let's Encrypt untuk domain di bawah
# dan memperpanjangnya sendiri (sekitar 30 hari sebelum kedaluwarsa).
# Syarat: DNS domain mengarah ke server ini dan port 80 + 443 terbuka.
{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}
