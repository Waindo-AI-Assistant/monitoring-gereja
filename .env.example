# PostgreSQL Credentials & Connection Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=monitoring_gereja
POSTGRES_PORT=5433

# Database Connection URL (digunakan oleh Prisma Client)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public"

# Secret Key untuk JWT Token Authentication (WAJIB, minimal 32 karakter acak)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ganti_dengan_string_acak_minimal_32_karakter"

# Password akun superadmin pertama (opsional). Jika kosong, password acak dicetak sekali ke log server.
INITIAL_SUPERADMIN_PASSWORD=""

# HTTPS otomatis (docker-compose.https.yml): domain publik + email notifikasi Let's Encrypt.
# Aktifkan dengan: docker compose -f docker-compose.yml -f docker-compose.https.yml up -d
# Port 80 dan 443 harus diteruskan (port forward) ke server ini.
DOMAIN="ggpdigital.com"
ACME_EMAIL=""

# Environment
NODE_ENV="development"
PORT=3000
